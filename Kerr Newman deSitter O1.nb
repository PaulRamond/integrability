Cell[TextData[{
 "Check of an identity for the linear in-spin correction to ",
 Cell[BoxData[
  FormBox["Q", TraditionalForm]],ExpressionUUID->
  "7e8d5ee1-ad4d-473a-a76f-c98f416bf8b1"],
 ":  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["L", "abc"], 
     SuperscriptBox["S", "ab"], 
     SuperscriptBox["p", "c"]}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "2"}], "\[Mu]", " ", 
      SubscriptBox["f", "ab"], " ", 
      SuperscriptBox["S", "a"], 
      SuperscriptBox["\[Xi]", "b"]}], "+", 
     RowBox[{
      SubscriptBox["\[Xi]", "a"], 
      RowBox[{
       SuperscriptBox["p", "a"], "(", 
       SuperscriptBox[
        SubscriptBox["f", "bc"], "\[FivePointedStar]"], ")"}], 
      SuperscriptBox["S", "bc"]}]}]}], TraditionalForm]],ExpressionUUID->
  "d089d647-ad42-40f9-b8d8-4622dd7123ea"]
}], "Subsubsection",
