            RowBox[{"-", "\[CapitalDelta]r"}], "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               SuperscriptBox["a", "2"], "+", 
               SuperscriptBox["r", "2"]}], ")"}], " ", 
             "\[CapitalDelta]\[Theta]"}]}], ")"}], " ", 
          SuperscriptBox[
           RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}], 
         RowBox[{
          SuperscriptBox["\[Chi]", "2"], " ", "\[CapitalSigma]"}]]}], ",", 
       "0", ",", "0", ",", 
       FractionBox[
        RowBox[{
         SuperscriptBox[
          RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"], " ", 
