            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{
               SuperscriptBox["a", "2"], "+", 
               SuperscriptBox["r", "2"]}], ")"}], "2"], " ", 
            "\[CapitalDelta]\[Theta]"}], "-", 
           RowBox[{
            SuperscriptBox["a", "2"], " ", "\[CapitalDelta]r", " ", 
            SuperscriptBox[
             RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}]}], ")"}]}], 
        RowBox[{
         SuperscriptBox["\[Chi]", "2"], "\[CapitalSigma]"}]]}], "}"}]}], 
    "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"simpRules", "=", 
