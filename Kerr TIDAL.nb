      RowBox[{"lU", ",", "nU"}], "]"}]}], "//", "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gddfromTetrad", "=", 
   RowBox[{
    RowBox[{
