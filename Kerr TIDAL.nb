     RowBox[{"OT", "[", 
      RowBox[{"ld", ",", "nd"}], "]"}]}], "//", "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SimpValTot", "[", 
