Cell[BoxData[{
 RowBox[{
  RowBox[{"\[CapitalDelta]", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["r", "2"], "+", 
      SuperscriptBox["a", "2"]}], ")"}], "-", 
    RowBox[{"2", "M", " ", "r"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalSigma]", "=", 
   RowBox[{
    SuperscriptBox["r", "2"], "+", 
    RowBox[{
     SuperscriptBox["a", "2"], 
     SuperscriptBox[
      RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Rho]", "=", 
   RowBox[{"r", "+", 
    RowBox[{"I", " ", "a", " ", 
     RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Rho]Bar", "=", 
   RowBox[{"r", "-", 
    RowBox[{"I", " ", "a", " ", 
     RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}]}], ";"}]}], "Input",
 CellLabel->
  "In[400]:=",ExpressionUUID->"a000a359-2d24-4e5c-9801-6ab28d6486b0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"lU", "=", 
   RowBox[{
    FractionBox["1", "\[CapitalDelta]"], 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       SuperscriptBox["a", "2"], "+", 
       SuperscriptBox["r", "2"]}], ",", "\[CapitalDelta]", ",", "0", ",", 
      "a"}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nU", "=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"2", "\[CapitalSigma]"}]], 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       SuperscriptBox["a", "2"], "+", 
       SuperscriptBox["r", "2"]}], ",", 
      RowBox[{"-", "\[CapitalDelta]"}], ",", "0", ",", "a"}], " ", "}"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mU", "=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{
      SqrtBox["2"], "\[Rho]"}]], 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[ImaginaryI]", " ", "a", " ", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}]}], ",", "0", ",", "1", ",", 
      RowBox[{"\[ImaginaryI]", " ", 
       RowBox[{"Csc", "[", "\[Theta]", "]"}]}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mBarU", "=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{
      SqrtBox["2"], " ", "\[Rho]Bar"}]], 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "\[ImaginaryI]"}], " ", "a", " ", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}]}], ",", "0", ",", "1", ",", 
      RowBox[{
       RowBox[{"-", "\[ImaginaryI]"}], " ", 
       RowBox[{"Csc", "[", "\[Theta]", "]"}]}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ld", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "1"}], ",", 
     FractionBox["\[CapitalSigma]", "\[CapitalDelta]"], ",", "0", ",", 
     RowBox[{"a", " ", 
      SuperscriptBox[
       RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nd", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["\[CapitalDelta]", 
       RowBox[{"2", "\[CapitalSigma]"}]]}], ",", 
     RowBox[{"-", 
      FractionBox["1", "2"]}], ",", "0", ",", 
     FractionBox[
      RowBox[{"a", " ", "\[CapitalDelta]", " ", 
       SuperscriptBox[
        RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}], 
      RowBox[{"2", "\[CapitalSigma]"}]]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"md", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], " ", 
      FractionBox[
       RowBox[{"a", " ", 
        RowBox[{"Sin", "[", "\[Theta]", "]"}]}], 
       RowBox[{
        SqrtBox["2"], " ", "\[Rho]", " "}]]}], ",", "0", ",", 
     FractionBox["\[Rho]Bar", 
