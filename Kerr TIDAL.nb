          SuperscriptBox["a", "2"], "+", 
          SuperscriptBox["r", "2"]}], ")"}], " ", 
        RowBox[{"Sin", "[", "\[Theta]", "]"}]}], 
       RowBox[{
        SqrtBox["2"], " ", "\[Rho]"}]]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"mBard", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[ImaginaryI]", " ", 
       FractionBox[
        RowBox[{"a", "  ", 
