    RowBox[{"OT", "[", 
     RowBox[{"lU", ",", "nU"}], "]"}]}], "//", "Simplify"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gUUfromTetrad", "=", 
